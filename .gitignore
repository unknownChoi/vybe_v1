# 환경변수 (API 키 — 절대 커밋 금지)
.env
functions/.env

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# v1 디자인 원본 — 이미지·영상 에셋 (25MB). 화면 코드는 커밋, 에셋은 로컬 폴더 참조
design/user/screen/assets/

# Firebase 키·설정 — 파일은 로컬에 두고 git 추적만 제외한다 (2026-10-03)
#   베타(vybe_bata)는 이 셋을 커밋했지만 v1 은 안 한다.
#   새로 clone 하면 이 세 파일을 받아 와야 빌드된다.
lib/firebase_options.dart
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

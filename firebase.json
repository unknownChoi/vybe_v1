{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "legal",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "buildConfigurations": {
          ".": {
            "projectId": "vybe-bata-c07aa-test",
            "appId": "1:885057347786:android:73d0de9d2085a41b265433",
            "fileOutput": "android/app/google-services.json"
          }
        }
      },
      "ios": {
        "targets": {
          "Runner": {
            "projectId": "vybe-bata-c07aa-test",
            "appId": "1:885057347786:ios:a99192df879fb4d3265433",
            "uploadDebugSymbols": false,
            "fileOutput": "ios/Runner/GoogleService-Info.plist"
          }
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "vybe-bata-c07aa-test",
          "configurations": {
            "android": "1:885057347786:android:73d0de9d2085a41b265433",
            "ios": "1:885057347786:ios:a99192df879fb4d3265433"
          }
        }
      }
    }
  }
}
